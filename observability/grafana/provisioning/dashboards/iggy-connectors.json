      "title": "Webhook requests by status",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (rate(http_source_requests_total{exported_instance=\"webhooks\"}[1m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(http_source_requests_total{exported_instance=\"unrouted\"}[1m]))",
          "legendFormat": "unknown path",
          "refId": "B"
        }
      ],
      "description": "HTTP source public listener. 4xx includes refused signatures (401); 'unknown path' counts requests to an endpoint id that does not exist."
    },
