      "title": "Messages through the connectors",
      "type": "timeseries",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (connector_key) (rate(iggy_connector_messages_sent_total{connector_type=\"source\"}[1m]))",
          "legendFormat": "{{connector_key}} sent to Iggy",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (connector_key) (rate(iggy_connector_messages_consumed_total{connector_type=\"sink\"}[1m]))",
          "legendFormat": "{{connector_key}} consumed",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (connector_key) (rate(iggy_connector_messages_processed_total{connector_type=\"sink\"}[1m]))",
          "legendFormat": "{{connector_key}} processed",
          "refId": "C"
